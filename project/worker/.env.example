# Copy to .env and fill in. The service role key is required: the worker writes to
# storage and updates rows, and it runs where no end user can read its environment.
# Never expose this key to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Required. The worker narrates scripts itself, because a long one needs several
# sequential ElevenLabs calls and an edge function is killed part way through for
# exceeding its wall-clock budget. Same value as the Supabase secret of this name.
ELEVENLABS_API_KEY=

# Required only if you want the worker to publish to YouTube. These are the same three
# values you set as Supabase edge function secrets, but the worker is a separate process
# and cannot see those — it needs its own copy here.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Optional
WORKER_ID=local
POLL_INTERVAL_MS=5000

# Full-quality masters. Set by docker-compose.yml when running in the container; set it
# yourself only when running the worker directly. Unset means masters are not kept at all.
# MASTERS_DIR=

# Retention for that folder. Both default to 0, meaning nothing is ever deleted.
#   MASTERS_MAX_GB   delete oldest first until the folder fits this budget
#   MASTERS_KEEP_DAYS delete anything older than this many days
# The newest render is never deleted, even if it alone exceeds the budget.
# MASTERS_MAX_GB=20
# MASTERS_KEEP_DAYS=0

# Font for thumbnail titles. The default is where the Docker image puts DejaVu, so leave
# this unset when running in the container. Set it only when running the worker directly
# on your machine — e.g. C:/Windows/Fonts/arialbd.ttf on Windows, or
# /System/Library/Fonts/Supplemental/Arial Bold.ttf on macOS.
# THUMBNAIL_FONT=
