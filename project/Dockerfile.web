# Builds the app and serves the static output. Multi-stage so the finished image is just
# nginx plus dist/ — Node and the dependency tree stay in the build stage and are dropped.
FROM node:22-bookworm-slim AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

# .env supplies VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY. Vite inlines them at build
# time, so the image has to be rebuilt if they change. The anon key is public by design —
# it ships in the bundle either way. The service role key is excluded via .dockerignore.
COPY . .
RUN npm run build

FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
